{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English Learning Lesson",
  "type": "object",
  "required": [
    "content_id",
    "version",
    "review_status",
    "metadata",
    "lines",
    "vocabulary",
    "exercises",
    "rights"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "draft",
        "needs_human_review",
        "approved_for_release",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "title_en",
        "title_zh",
        "level",
        "topic",
        "estimated_duration_seconds"
      ],
      "properties": {
        "title_en": {
          "type": "string"
        },
        "title_zh": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "estimated_duration_seconds": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "english",
          "chinese"
        ],
        "properties": {
          "order": {
            "type": "integer"
          },
          "english": {
            "type": "string"
          },
          "chinese": {
            "type": "string"
          },
          "audio_start_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "audio_end_ms": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "part_of_speech",
          "meaning_zh",
          "example_en",
          "example_zh"
        ]
      }
    },
    "exercises": {
      "type": "object",
      "required": [
        "multiple_choice",
        "dictation"
      ],
      "properties": {
        "multiple_choice": {
          "type": "array"
        },
        "dictation": {
          "type": "array"
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "source_method",
        "rights_status",
        "attribution_required",
        "commercial_use_allowed",
        "human_review_required"
      ]
    }
  }
}

