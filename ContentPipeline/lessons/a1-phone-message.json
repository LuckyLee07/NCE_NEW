      "audio_end_ms": null
    },
    {
      "order": 7,
      "english": "It is 555-2190.",
      "chinese": "是 555-2190。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 8,
      "english": "Can you repeat that?",
      "chinese": "你能重复一遍吗？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 9,
      "english": "Sure, 555-2190.",
      "chinese": "当然，555-2190。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 10,
      "english": "Thank you. I will tell her.",
      "chinese": "谢谢。我会告诉她。",
