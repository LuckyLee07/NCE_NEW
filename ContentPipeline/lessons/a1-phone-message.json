      "english": "Sorry, she is not here now.",
      "chinese": "抱歉，她现在不在。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 3,
      "english": "Can I leave a message?",
      "chinese": "我可以留言吗？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 4,
      "english": "Yes, of course.",
      "chinese": "是的，当然可以。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 5,
      "english": "Please tell her Tom called.",
      "chinese": "请告诉她汤姆来过电话。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 6,
      "english": "What is your phone number?",
      "chinese": "你的电话号码是多少？",
