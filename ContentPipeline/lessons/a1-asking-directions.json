  "lines": [
    {
      "order": 1,
      "english": "Excuse me. Where is the train station?",
      "chinese": "打扰一下。火车站在哪里？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 2,
      "english": "It is not far from here.",
      "chinese": "离这里不远。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 3,
      "english": "Go straight for two blocks.",
      "chinese": "直走两个街区。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 4,
      "english": "Then turn left at the bank.",
      "chinese": "然后在银行那里左转。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 5,
      "english": "Is it next to the park?",
      "chinese": "它在公园旁边吗？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 6,
      "english": "Yes, it is across from the park.",
      "chinese": "是的，它在公园对面。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 7,
      "english": "How long does it take to walk there?",
      "chinese": "走到那里要多久？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 8,
      "english": "About ten minutes.",
      "chinese": "大约十分钟。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 9,
      "english": "Thank you for your help.",
      "chinese": "谢谢您的帮助。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 10,
      "english": "You are welcome.",
      "chinese": "不客气。",
      "audio_start_ms": null,
      "audio_end_ms": null
    }
  ],
