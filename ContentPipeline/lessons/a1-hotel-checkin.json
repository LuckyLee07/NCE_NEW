      "order": 1,
      "english": "Good evening. I have a reservation.",
      "chinese": "晚上好。我有预订。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 2,
      "english": "May I have your name, please?",
      "chinese": "请问您的姓名？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 3,
      "english": "My name is Anna Lee.",
      "chinese": "我的名字是安娜·李。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 4,
      "english": "You booked a single room for two nights.",
      "chinese": "您预订了一个单人间，住两晚。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 5,
      "english": "Yes, that is right.",
      "chinese": "是的，没错。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 6,
      "english": "Can I see your passport?",
      "chinese": "我可以看一下您的护照吗？",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 7,
      "english": "Here it is.",
      "chinese": "给您。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 8,
      "english": "Your room is on the third floor.",
      "chinese": "您的房间在三楼。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 9,
      "english": "Breakfast is from seven to ten.",
      "chinese": "早餐时间是七点到十点。",
      "audio_start_ms": null,
      "audio_end_ms": null
    },
    {
      "order": 10,
      "english": "Thank you. Where is the elevator?",
      "chinese": "谢谢。电梯在哪里？",
      "audio_start_ms": null,
      "audio_end_ms": null
